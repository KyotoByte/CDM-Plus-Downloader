<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CDM" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cdm_bg</item>
        <item name="android:statusBarColor">@color/cdm_bg</item>
        <item name="android:navigationBarColor">@color/cdm_bg</item>
    </style>
    <style name="Theme.CDM.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cdm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.CDM</item>
    </style>
</resources>
